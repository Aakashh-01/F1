# This .gitignore file should be placed at the root of your Unity project directory
#
# Get latest from https://github.com/github/gitignore/blob/main/Unity.gitignore
#
.utmp/
/[Ll]ibrary/
/[Tt]emp/
/[Oo]bj/
/[Bb]uild/
/[Bb]uilds/
/[Ll]ogs/
/[Uu]ser[Ss]ettings/
*.log

# MemoryCaptures can get excessive in size.
# They also could contain extremely sensitive data
/[Mm]emoryCaptures/

# Recordings can get excessive in size
/[Rr]ecordings/

# Uncomment this line if you wish to ignore the asset store tools plugin
# /[Aa]ssets/AssetStoreTools*

# Autogenerated Jetbrains Rider plugin
/[Aa]ssets/Plugins/Editor/JetBrains*

# Visual Studio cache directory
.vs/

# Gradle cache directory
.gradle/

# Autogenerated VS/MD/Consulo solution and project files
ExportedObj/
.consulo/
*.csproj
*.unityproj
*.sln
*.suo
*.tmp
*.user
*.userprefs
*.pidb
*.booproj
*.svd
*.pdb
*.mdb
*.opendb
*.VC.db

# Unity3D generated meta files
*.pidb.meta
*.pdb.meta
*.mdb.meta

# Unity3D generated file on crash reports
sysinfo.txt

# Builds
*.apk
*.aab
*.unitypackage
*.unitypackage.meta
*.app

# Crashlytics generated file
crashlytics-build.properties

# Packed Addressables
/[Aa]ssets/[Aa]ddressable[Aa]ssets[Dd]ata/*/*.bin*

# Temporary auto-generated Android Assets
/[Aa]ssets/[Ss]treamingAssets/aa.meta
/[Aa]ssets/[Ss]treamingAssets/aa/*

# ---------------------------------------------------------------------------
# Local tooling, captures and scratch files. None of this is game content;
# it is what accumulates in a working copy and should never reach the repo.
# ---------------------------------------------------------------------------

# AI/agent tool configuration (per-machine)
.claude/
.cline/
.codex/
.mcp.json
graphify-out/
CAMERA_RESTORE_PLAN.md

# Unity MCP server dependencies. The MCP package itself is already a git
# dependency in Packages/manifest.json; these are the loose DLLs and the
# stray local copy of its editor code.
/Assets/Plugins/NuGet/
/Assets/Plugins/NuGet.meta
/Assets/Plugins/Roslyn/
/Packages/Coplay/

# Embedded editor-only third-party package (asset tool, not gameplay)
/Packages/com.bezi.sidekick/

# Screenshots and viewport captures. Diagnostic output, several MB each, and
# nothing references them. The .meta is ignored with the folder so Unity
# regenerates both on a fresh clone instead of committing a dangling ref.
/Assets/Screenshots/
/Assets/Screenshots.meta
/Assets/Scenes/Screenshot *.png
/Assets/Scenes/Screenshot *.png.meta

# Scenes left behind by automated test runs
/Assets/InitTestScene*.unity
/Assets/InitTestScene*.unity.meta

# Scratch/reference PDFs, duplicated between the repo root and Assets
/pdf1.pdf
/pdf2.pdf
/Assets/Assets/pdf1.pdf
/Assets/Assets/pdf1.pdf.meta
/Assets/Assets/pdf2.pdf
/Assets/Assets/pdf2.pdf.meta
